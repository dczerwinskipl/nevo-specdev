# Normalize line endings: repo is LF, checkout is LF everywhere.
* text=auto eol=lf

# Explicit text
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.json   text eol=lf
*.jsonc  text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.sh     text eol=lf

# Windows-only scripts keep CRLF
*.ps1    text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.pdf    binary

# Generated / vendored files: collapse in PR diffs and exclude from language stats.
pnpm-lock.yaml            linguist-generated=true -diff
docs/**/*.generated.*     linguist-generated=true
**/*.generated.*          linguist-generated=true
docs/**                   linguist-documentation=true
