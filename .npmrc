# Enforce the Node/pnpm versions declared in package.json#engines.
engine-strict=true

# Pin exact versions on `pnpm add` so dependency bumps are always explicit and reviewable.
save-exact=true

# Fail instead of silently falling back when the frozen lockfile is out of date in CI.
# (pnpm already does this automatically when CI=true; kept explicit for clarity.)
# strict-peer-dependencies is left at pnpm's default so first-party peers surface as warnings.
