{
  "name": "nevo-specdev",
  "private": true,
  "type": "module",
  "description": "Workspace root for Nevo SpecDev — a spec-driven development framework for AI-assisted software engineering.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:print": "node tools/release/bin/version.mjs",
    "version:check-transition": "node tools/release/bin/check-version-transition.mjs",
    "governance:test": "node --test \"scripts/github/**/*.test.mjs\"",
    "check:quality": "pnpm format:check && pnpm lint && pnpm docs:check && pnpm version:check-transition && pnpm governance:test",
    "check": "pnpm check:quality && turbo run typecheck test build",
    "docs:list": "node tools/docs/bin/docs.mjs list",
    "docs:find": "node tools/docs/bin/docs.mjs find",
    "docs:context": "node tools/docs/bin/docs.mjs context",
    "docs:check": "node tools/docs/bin/docs.mjs check",
    "docs:adr": "node tools/docs/bin/docs.mjs adr"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
