{
  "name": "@nevo-specdev/root",
  "version": "0.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Workspace root for Nevo SpecDev — a spec-driven development framework for AI-assisted software engineering.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck test build",
    "docs:list": "node tools/docs/bin/docs.mjs list",
    "docs:find": "node tools/docs/bin/docs.mjs find",
    "docs:context": "node tools/docs/bin/docs.mjs context",
    "docs:check": "node tools/docs/bin/docs.mjs check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
